# ---------------
# LOCAL RULES
# ---------------
# This file intentionally does not come with signatures. Put your local
# additions here.

alert icmp any any -> $HOME_NET any (msg:"ICMP Ping Detected"; itype:8; sid:1000001; rev:1;)
alert icmp 192.168.56.108 any -> $HOME_NET any (msg:"ICMP Ping from Kali Attacker"; itype:8; sid:1000002; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"ICMP Ping Flood Detected"; threshold:type both,track by_src,count 5,seconds 1; sid:1000003; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"NMAP SYN Port Scan"; flags:S; threshold:type threshold,track by_src,count 15,seconds 2; sid:1000010; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"NMAP NULL Scan"; flags:0; sid:1000011; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"NMAP FIN Scan"; flags:F; sid:1000012; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"NMAP XMAS Scan"; flags:FUP; sid:1000013; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force Attempt"; flags:S; threshold:type both,track by_src,count 5,seconds 10; sid:1000030; rev:1;)
alert tcp any any -> $HOME_NET 80 (msg:"HTTP Port Scan Detected"; flags:S; threshold:type both,track by_src,count 30,seconds 5; sid:1000020; rev:1;)
